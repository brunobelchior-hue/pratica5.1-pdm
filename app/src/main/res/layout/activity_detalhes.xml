<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CURRÍCULO"
            android:textColor="#A6FF00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BRUNO ROCHA"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profissão"
            android:textColor="#A6FF00"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consultor de Vendas Fiat | Seminovos Multimarcas"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Experiência"
            android:textColor="#A6FF00"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atendimento e consultoria na venda de veículos novos e seminovos, financiamento, avaliação de veículos usados e atendimento online."
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Habilidades"
            android:textColor="#A6FF00"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Vendas consultivas&#10;• Atendimento ao cliente&#10;• Negociação&#10;• Financiamento de veículos&#10;• Veículos novos e seminovos"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:lineSpacingExtra="8dp" />

    </LinearLayout>

</ScrollView>