<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="30dp"
    android:background="#111111">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONTATO"
        android:textColor="#A6FF00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BRUNO ROCHA"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="35dp" />

    <TextView
        android:id="@+id/telefone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center_vertical"
        android:text="📞  Telefone (38)9990-6200"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="10dp"
        android:background="#222222"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/email"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center_vertical"
        android:text="📧  E-mail bruno.souza@primavia.com.br"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="10dp"
        android:background="#222222"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/site"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center_vertical"
        android:text="🌐  LinkedIn / Site"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="10dp"
        android:background="#222222"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/btnCompartilhar"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="📤  COMPARTILHAR CONTATO"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>